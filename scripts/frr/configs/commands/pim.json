    "/interfaces/@element/ip/igmp/last-member-query-count": "ip igmp last-member-query-count {/@text}",
    "/interfaces/@element/ip/igmp/last-member-query-interval": "ip igmp last-member-query-interval {/@text}",
    "/interfaces/@element/ip/igmp/query-interval": "ip igmp query-interval {/@text}",
    "/interfaces/@element/ip/igmp/query-max-response-time": "ip igmp query-max-response-time {/@text}",
    "/interfaces/@element/ip/igmp/join-group/@element": "ip igmp join-group {/tagnode/@text} [{/source/@text},]",
    "/interfaces/@element/ip/igmp/static-group/@element": "ip igmp static-group {/tagnode/@text} [{/source/@text},]"
