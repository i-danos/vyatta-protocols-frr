    "/protocols/pim/rp/@element/prefix-list": "ip pim rp {../tagnode/@text} prefix-list {/@text}",
    "/protocols/pim/spt-switchover/infinity-and-beyond": "ip pim spt-switchover infinity-and-beyond [prefix-list {/prefix-list/@text},]",
